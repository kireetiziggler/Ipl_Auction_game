# GEMINI_API_KEY: Optional for AI Studio runtime. Core IPL Auction Arena uses 100% free local/server strategic AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode protecting the Admin Data Studio.
# If unset on first run, an inline first-run Admin setup/claim form lets you set a hashed admin password.
ADMIN_PASSCODE=

# ELEVENLABS_API_KEY: Optional premium neural TTS key (defaults automatically to studio neural Indian-English voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

