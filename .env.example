# ==================== SERVER & RUNTIME ====================
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"
TRUST_PROXY_HOPS=1

# ==================== POSTGRESQL / CLOUD SQL ====================
# Cloud SQL / PostgreSQL connection variables (Object Method — no hardcoded credentials)
SQL_HOST=localhost
SQL_DB_NAME=ipl_auction_arena
SQL_USER=app_user
SQL_PASSWORD=
# Admin credentials used exclusively by Drizzle Kit migrations (src/db/drizzle.config.ts)
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=
SQL_POOL_MAX=10

# ==================== AUTHENTICATION & SESSIONS ====================
SESSION_TTL_HOURS=168
GUEST_SESSION_TTL_HOURS=72
ADMIN_SESSION_TTL_HOURS=12

# ==================== MULTIPLAYER & RATE LIMITING ====================
ROOM_RECONNECT_GRACE_SECONDS=90
ROOM_RETENTION_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
WS_MAX_PAYLOAD_BYTES=32768
WS_HEARTBEAT_INTERVAL_MS=25000

# ==================== ADMIN & OPTIONAL INTEGRATIONS ====================
# ADMIN_PASSCODE: Optional server-side passcode protecting Admin Data Studio.
# Overrides DB-stored admin credentials when set; if unset, first-run claim locks once configured.
ADMIN_PASSCODE=

# ELEVENLABS_API_KEY: Optional premium neural TTS key (defaults automatically to built-in neural voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# GEMINI_API_KEY: Optional for AI Studio runtime. Core IPL Auction Arena uses 100% deterministic strategic AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
