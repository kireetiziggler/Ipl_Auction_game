# Environment variables for IPL Auction Arena.
#
# In AI Studio & Cloud Run (Publish), PostgreSQL credentials are injected
# automatically by the provisioned Cloud SQL instance—no manual secrets are needed.
# All runtime settings below use safe built-in defaults in src/server/config.ts.
#
# For self-hosting outside AI Studio, uncomment and set as needed:
# PORT=3000
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
#
# PostgreSQL / Cloud SQL (auto-injected by Cloud SQL in AI Studio):
# SQL_HOST=localhost
# SQL_DB_NAME=ipl_auction_arena
# SQL_USER=app_user
# SQL_PASSWORD=
# SQL_ADMIN_USER=postgres
# SQL_ADMIN_PASSWORD=
# SQL_POOL_MAX=10
#
# Optional session, room & rate-limit tuning (defaults active automatically):
# SESSION_TTL_HOURS=168
# GUEST_SESSION_TTL_HOURS=72
# ADMIN_SESSION_TTL_HOURS=12
# ROOM_RECONNECT_GRACE_SECONDS=90
# ROOM_RETENTION_HOURS=24
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60
# WS_MAX_PAYLOAD_BYTES=32768
# WS_HEARTBEAT_INTERVAL_MS=25000
#
# Optional overrides (not required to run or publish):
# ADMIN_PASSCODE=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
